{
  "manifest_version": 3,
  "name": "cliento - Google Maps Scraper",
  "version": "1.5.0",
  "description": "Ambil data bisnis Google Maps setelah klik pengguna, unduh rekap JSON, lalu impor ke cliento.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "cliento Google Maps Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.id/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
