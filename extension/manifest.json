{
  "manifest_version": 3,
  "name": "cliento - Google Maps Scraper",
  "version": "1.6.0",
  "description": "Ambil data bisnis Google Maps setelah klik pengguna, kirim otomatis ke tab cliento atau unduh rekap JSON.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "cliento Google Maps Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.id/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://recreativeid.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
