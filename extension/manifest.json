{
  "manifest_version": 3,
  "name": "cliento - Google Maps Scraper",
  "version": "1.7.0",
  "description": "Hubungkan Agen PC / XAMPP Localhost ke https://cliento.my.id tanpa blokir LNA, plus auto-scrape Google Maps 1 klik.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:43210/*",
    "http://localhost:43210/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "cliento Google Maps Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.id/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cliento.my.id/*",
        "https://www.cliento.my.id/*",
        "https://recreativeid.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
