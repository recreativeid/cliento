{
  "manifest_version": 3,
  "name": "cliento - Google Maps Scraper",
  "version": "1.6.1",
  "description": "Ambil data bisnis Google Maps, hubungkan Agen PC Lokal tanpa blokir LNA, dan kirim otomatis ke tab cliento.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:43210/*",
    "http://localhost:43210/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "cliento Google Maps Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.id/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cliento.my.id/*",
        "https://www.cliento.my.id/*",
        "https://recreativeid.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
